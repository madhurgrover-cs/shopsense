# Copy this file to .env and fill in your own values. Never commit .env.

# Neon connection string. Use the "psycopg" driver prefix and keep sslmode=require.
# Example: postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/shopsense?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Set to 1 to print every SQL statement (useful while debugging).
SQL_ECHO=0

# Google Gemini key for the admin "Ask your data" screen (free key: aistudio.google.com).
# Optional: without it, everything else works.
GEMINI_API_KEY=
# Optional: override the Gemini models (defaults: gemini-3.5-flash, and
# gemini-3.5-flash-lite when the first one is overloaded).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
